# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 커밋되지 않습니다)

# --- Gmail 발송 ---
# 앱 비밀번호는 Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호 에서 발급합니다.
# 계정 비밀번호가 아니라 16자리 앱 비밀번호여야 합니다.
GMAIL_USER=hylee@krxoptionadvisor.cloud
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=에이톰엔지니어링

# 1이면 실제 전송 대신 성공만 반환합니다. 실전 발송 직전에 0 으로 바꾸세요.
DRY_RUN=1

# --- LLM ---
# ollama | claude-api | claude-cli  (비우면 자동 감지: ollama 우선)
LLM_BACKEND=
OLLAMA_MODEL=exaone3.5:7.8b
OLLAMA_NUM_PREDICT=800
