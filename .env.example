# SafeLead 환경 설정 보기
#
# 이 파일은 '어떤 값이 있는지' 만 적어 둔 견본이다. 실제 값은 .env 에 넣는다.
# .env 는 .gitignore 에 걸려 있어 저장소에 올라가지 않는다 — 비밀번호와
# API 키가 GitHub 에 남지 않게 하려는 것이다. 이 파일에는 값을 적지 않는다.
#
# 넣는 방법은 두 가지다.
#   1) 화면에서 — 왼쪽 메뉴 ⚙ 관리자 설정. 저장하면 .env 에 바로 쓰인다.
#      비밀번호·API 키를 이 방법으로 넣으면 파일을 직접 열 일이 없다. 권장.
#   2) 파일에서 — 이 파일을 .env 로 복사한 뒤 = 뒤에 값을 적는다.
#
# 배포(Render)에서는 .env 대신 대시보드 → Environment 에 넣는다.

# ==================================================================
#  메일 발송
# ==================================================================

# 보내는 사람 주소
#   영업 메일이 나갈 때 '보낸사람'으로 찍히는 지메일 주소입니다.
#   왜: 받는 분이 답장하면 이 주소로 옵니다. 회신을 실제로 확인하는 주소를 넣으세요.
#   예: yourname@gmail.com
GMAIL_USER=

# 앱 비밀번호 (16자리)   ⚠ 비밀값 — 저장소·메신저에 붙여넣지 말 것
#   구글이 프로그램 전용으로 발급하는 16자리 비밀번호입니다.
#   왜: 구글 계정 비밀번호나 2단계 인증 백업 코드는 여기서 작동하지 않습니다. 구글 계정 > 보안 > 2단계 인증 > 앱 비밀번호 에서 새로 발급하세요.
#   예: abcdefghijklmnop
GMAIL_APP_PASSWORD=

# 보내는 사람 이름
#   받는 분의 메일함에 표시되는 이름입니다.
#   왜: 'atom@...' 대신 '에이톰엔지니어링'으로 보이면 열람률이 올라갑니다.
#   예: 에이톰엔지니어링
GMAIL_FROM_NAME=

# 연습 모드
#   1이면 보내는 척만 하고 실제로는 나가지 않습니다.
#   0이면 진짜로 발송합니다.
#   왜: ⚠ 0으로 바꾸는 순간부터 실제 메일이 나갑니다. 실전 캠페인 직전에만 0으로 두세요.
#   예: 1
DRY_RUN=

# 테스트 수신 주소
#   여기에 주소를 넣으면 모든 메일이 진짜 수신자 대신 이 주소로만 갑니다.
#   원래 수신자는 제목과 본문 머리에 남습니다.
#   왜: ⚠ 실전 발송 전에는 반드시 비우세요. 비우지 않으면 고객에게 한 통도 가지 않습니다.
#   예: me@example.com
TEST_REDIRECT_TO=

# 테스트 메일 받는 사람
#   STEP 7 의 [테스트 메일 보내기] 화면에 처음 채워 둘 주소입니다.
#   왜: 매번 손으로 적지 않아도 되게 합니다. 보낼 때 다른 주소로 바꿔도 됩니다.
#   예: atom@atom-eng.co.kr
TEST_SEND_TO=

# 야간 발송 허용
#   1이면 밤 9시~아침 8시에도 발송합니다.
#   비워두면 그 시간대는 차단됩니다.
#   왜: 정보통신망법상 광고성 정보의 야간 전송은 제한됩니다. 본인 주소로 테스트할 때만 잠깐 1로 두고, 실제 캠페인 전에 반드시 되돌리세요.
#   예: 0
ALLOW_NIGHT_SEND=

# 수신거부 존중
#   1이면 명함의 '수신 동의' 칸이 거부인 사람에게는 보내지 않습니다.
#   왜: 광고성 정보는 사전 동의가 원칙입니다. 거부 의사를 적어 둔 사람에게 발송되면 기록이 남아 있다는 점 때문에 더 무겁게 다뤄집니다. 켜 두세요.
#   예: 1
RESPECT_CONSENT=

# 재발송 차단 기간(일)
#   같은 사람에게 이 일수 안에는 다시 보내지 않습니다.
#   0이면 제한 없음.
#   왜: 같은 내용을 반복해 받으면 스팸 신고로 이어지고, 한 번 상한 발신 도메인 평판은 되돌리기 어렵습니다. 30일이 무난합니다.
#   예: 30
RESEND_BLOCK_DAYS=

# 하루 발송 상한(건)
#   하루에 보낼 수 있는 최대 건수입니다.
#   0이면 제한 없음.
#   왜: Gmail 개인 계정은 하루 500통 안팎에서 계정이 잠깁니다. 잠기면 회사 메일 전체가 멈추므로 넉넉히 낮춰 두는 편이 낫습니다.
#   예: 100
DAILY_SEND_LIMIT=

# 발송 간격(초)
#   메일 한 통과 다음 통 사이에 쉬는 시간입니다.
#   왜: 한꺼번에 쏟아내면 스팸 필터에 걸리기 쉽습니다. 사람이 보내는 속도에 가깝게 두는 편이 도달률에 유리합니다.
#   예: 2
SEND_INTERVAL_SEC=


# ==================================================================
#  AI
# ==================================================================

# AI 백엔드
#   메일 문구를 쓰는 AI 를 무엇으로 할지 고릅니다.
#   claude-api(인터넷·빠름) / claude-cli(내 PC의 Claude Code) / ollama(로컬 모델).
#   왜: 비워두면 자동으로 고릅니다. 배포 서버에는 Claude Code 가 없으므로 claude-api 로 두세요.
#   예: claude-api
LLM_BACKEND=

# Anthropic API 키   ⚠ 비밀값 — 저장소·메신저에 붙여넣지 말 것
#   claude-api 를 쓸 때 필요한 열쇠입니다.
#   console.anthropic.com 에서 발급합니다.
#   왜: 이 키가 있어야 홈페이지 분석·고객군 분류·문구 생성이 전부 동작합니다. 사용한 만큼 요금이 부과되며, 노출되면 즉시 폐기하고 새로 발급하세요.
#   예: sk-ant-api03-...
ANTHROPIC_API_KEY=

# 백엔드 전환 대기 시간(초)
#   AI 한 곳에 최대 몇 초까지 기다릴지입니다.
#   넘기면 실패로 보고 다음 AI 로 넘어갑니다.
#   왜: 로컬 모델은 한 건에 5분이 넘기도 합니다. 무한정 기다리면 화면이 먼저 끊겨 '그냥 안 된다'로만 보입니다. 짧게 잡으면 빠른 AI 로 일찍 넘어가고, 길게 잡으면 로컬에서 끝까지 시도합니다.
#   예: 150
LLM_STEP_TIMEOUT_SEC=

# 미분류 대체 고객군
#   규칙도 AI 도 업종을 정하지 못한 명함을 어느 고객군으로 볼지입니다.
#   비워 두면 office(오피스·자산관리)를 씁니다.
#   왜: 미분류로 남은 명함은 발송 대상에서 빠져 5~7단계가 열리지 않습니다. 기본값이 있으면 파이프라인이 멈추지 않고 끝까지 가지만, 엉뚱한 업종에 엉뚱한 메일이 갈 수 있습니다. 화면에는 '기본값 대체'로 표시되니 4단계 표에서 사람이 직접 고쳐 넣으세요.
#   예: office
DEFAULT_SEGMENT=

# Ollama 모델
#   로컬 AI 를 쓸 때 어떤 모델을 쓸지 지정합니다.
#   왜: 이름에 -cloud 가 붙은 모델은 로컬이 아니라 외부로 전송됩니다. 명함 정보를 PC 밖으로 내보내지 않으려면 -cloud 가 없는 모델을 쓰세요.
#   예: exaone3.5:7.8b
OLLAMA_MODEL=

# 생성 길이 상한
#   로컬 모델이 한 번에 만들 수 있는 글자 수 상한입니다.
#   왜: 크게 잡으면 문장이 길어지지만 생성 시간도 같이 늘어납니다.
#   예: 500
OLLAMA_NUM_PREDICT=

# 모델 상주 시간
#   로컬 모델을 메모리에 얼마나 붙잡아 둘지입니다.
#   왜: 짧으면 호출 사이에 모델이 내려가 다음 호출에 재로딩(수 분)이 붙습니다.
#   예: 30m
OLLAMA_KEEP_ALIVE=


# ==================================================================
#  서버
# ==================================================================

# 접속 포트
#   이 화면의 주소 뒤에 붙는 번호입니다 (localhost:5173).
#   왜: 다른 프로그램과 겹칠 때만 바꾸세요. 바꾸면 서버를 다시 켜야 합니다.
#   예: 5173
PORT=

# 접속 아이디
#   로그인 화면에서 입력할 아이디입니다.
#   비워 두면 atom 입니다.
#   왜: 비밀번호와 함께 맞아야 들어올 수 있습니다.
#   예: atom
APP_USER=

# 로그인 힌트
#   로그인 화면 아래에 그대로 보여 줄 안내 문구입니다.
#   왜: ⚠ 여기에 비밀번호를 적으면 화면을 여는 누구나 볼 수 있습니다. 사내 시연용으로만 쓰고, 실제 운영에서는 비우세요.
#   예: 예) 아이디·비밀번호 모두 atom
APP_HINT=

# 접속 비밀번호   ⚠ 비밀값 — 저장소·메신저에 붙여넣지 말 것
#   이 값을 넣으면 화면과 API 전체가 잠기고, 들어올 때 비밀번호를 묻습니다.
#   비우면 누구나 열 수 있습니다.
#   왜: ⚠ 사내망·인터넷에 올린다면 반드시 넣으세요. 이 화면에는 명함(개인정보)과 발송 설정이 들어 있습니다. 바꾸면 접속해 있던 사람은 모두 다시 로그인해야 합니다.
#   예: 사내에서 공유할 비밀번호
APP_PASSWORD=

# 테넌트 ID
#   데이터를 구분하는 칸 이름입니다.
#   회사가 여럿일 때 서로 섞이지 않게 합니다.
#   왜: 바꾸면 빈 데이터로 시작합니다. 기존 명함은 이전 값에 그대로 남아 있습니다.
#   예: atom-eng
TENANT_ID=
